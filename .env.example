# =============================================================================
# Alpica — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- MySQL database (shared by crawler + api) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=change-me
DB_USER=change-me
DB_PASSWORD=change-me
# Connection pool size
DB_CONNECTION_LIMIT=10

# --- API server ---
API_PORT=3001
# Interface to bind to. Defaults to 127.0.0.1 (loopback) so the API is NOT
# reachable from outside the host — only the co-located web server calls it.
# Only set this to 0.0.0.0 if you deliberately want to expose the API.
API_HOST=127.0.0.1
# CORS origin. With a loopback-only API this is mostly irrelevant, but keep it
# tight in any exposed setup.
API_CORS_ORIGIN=*

# --- Crawler ---
# PowderGuide API base URL
POWDERGUIDE_BASE_URL=https://powderguide.com
# Camptocamp (C2C) API + website base URLs
CAMPTOCAMP_BASE_URL=https://api.camptocamp.org
CAMPTOCAMP_WEB_URL=https://www.camptocamp.org
# Safety cap on how many outings to pull in a single run (esp. the first run,
# since C2C has no reliable "updated since" filter and paging newest-first).
CAMPTOCAMP_MAX_ITEMS=2000
# Thumbnails: C2C list items have no image; fetching one costs an extra detail
# request per outing that has images. Toggle and tune below.
CAMPTOCAMP_FETCH_THUMBNAILS=true
# Thumbnail size: SI (200x200 square), MI (400px), BI (1500px)
CAMPTOCAMP_THUMBNAIL_SIZE=MI
# Media storage base URL for building thumbnail URLs
CAMPTOCAMP_MEDIA_URL=https://media.camptocamp.org/c2corg-active
# Pause between per-outing detail requests (ms) to be gentle on the API
CAMPTOCAMP_DETAIL_DELAY_MS=250
# skitour.fr API — auth is a custom "cle" header. Get a key from your profile.
SKITOUR_API_KEY=your-skitour-key-here
SKITOUR_BASE_URL=https://skitour.fr/api
SKITOUR_WEB_URL=https://skitour.fr
# Safety cap on outings per run (rate limits: 1000/24h, 60/min)
SKITOUR_MAX_ITEMS=2000
# Timezone the skitour.fr day-granular dates are anchored to (French site).
SKITOUR_TIMEZONE=Europe/Paris
# Gipfelbuch.ch V2 API. The key must be passed as the api_key query param
# (the documented X-API-KEY header is rejected on this installation).
GIPFELBUCH_API_KEY=your-gipfelbuch-key-here
GIPFELBUCH_BASE_URL=https://www.gipfelbuch.ch
# Max results per request. The API has no pagination and this is a hard cap, so
# keep it well above the number of conditions expected in a crawl window.
GIPFELBUCH_LIMIT=2000
# Optional: how many days to look back on the very first run (no watermark yet)
CRAWLER_INITIAL_LOOKBACK_DAYS=30
# Page size when fetching lists (max 100 for both PowderGuide and Camptocamp)
CRAWLER_PAGE_SIZE=100

# --- Pre-launch gate (HTTP Basic Auth over the whole site) ---
# While set, the ENTIRE site (page, assets, and the /api/* proxy) is behind a
# browser login prompt — use this before go-live so the site isn't public yet.
# Leave SITE_PASSWORD empty / unset to make the site public (gate disabled).
SITE_USERNAME=preview
SITE_PASSWORD=
# Optional text shown in the browser's login dialog.
SITE_AUTH_REALM=Restricted — preview

# --- Website (SSR Angular) ---
# The website talks to the API server-side ONLY. These never reach the browser.
# Use 127.0.0.1 (not localhost) to match the loopback-only API bind above.
API_BASE_URL=http://127.0.0.1:3001
API_KEY=your-api-key-here
# Port the Angular SSR server listens on (read by the generated server.ts)
PORT=4000
# Hosts the SSR server accepts in the Host header (comma-separated). This is an
# Angular SSR security check against host-header/DNS-rebinding attacks. Set it
# to your real domain(s) in production, e.g. NG_ALLOWED_HOSTS=mountain-radar.example
NG_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Proxy protection (guards /api/* so only our own app can use it) ---
# Browser origins allowed to call the proxy (comma-separated). Set to your real
# domain(s) in production, e.g. https://mountainradar.example
WEB_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
# Secret used to sign the per-session token cookie. Set a long random value in
# production; if unset, a random per-process secret is generated (single-instance
# only — sessions break across restarts / multiple instances).
WEB_SESSION_SECRET=
# Send the session cookie only over HTTPS. Set to true in production.
WEB_COOKIE_SECURE=false
# Max proxy requests per client IP per minute.
WEB_PROXY_RATE_LIMIT=120
